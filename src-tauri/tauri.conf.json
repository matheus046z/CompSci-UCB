{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CompSci UCB",
  "version": "0.1.0",
  "identifier": "br.com.matheus.compsciucb",
  "build": {
    "beforeBuildCommand": "npm run build:offline",
    "beforeDevCommand": "npm run build:offline",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "CompSci UCB",
        "width": 390,
        "height": 844,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
